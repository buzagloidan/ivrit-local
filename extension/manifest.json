{
  "manifest_version": 3,
  "name": "Ivrit Local — תמלול בעברית",
  "version": "0.2.3",
  "description": "תמלול פרטי בעברית. מודל זיהוי הדיבור כלול בתוסף ופועל במכשיר שלכם, גם ללא אינטרנט.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "פתיחת Ivrit Local"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "פתיחת תמלול בעברית"
    },
    "toggle-microphone": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "התחלה או עצירה של הקלטת מיקרופון"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; media-src 'self' blob:"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "homepage_url": "https://github.com/buzagloidan/ivrit-local",
  "incognito": "not_allowed"
}
