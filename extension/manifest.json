{
  "manifest_version": 3,
  "name": "Ivrit Local \u2014 Hebrew Dictation",
  "version": "0.2.0",
  "description": "Private Hebrew dictation. The speech model is bundled and runs on your device, even offline.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Ivrit Local"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Hebrew dictation"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; media-src 'self' blob:"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "homepage_url": "https://github.com/buzagloidan/ivrit-local",
  "incognito": "not_allowed"
}
